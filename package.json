{
  "name": "@astrana/repository-tooling",
  "private": true,
  "description": "Formatting and linting tools for the whole repository. Nothing here ships.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "biome format --write . && prettier --write \"**/*.{md,yml,yaml}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,yml,yaml}\"",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "prettier": "3.9.10"
  }
}
