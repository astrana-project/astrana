# Shared editor settings for the whole repository. The .NET projects add their C# style rules in backend/.editorconfig.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.{cs,csproj,props,targets,slnx}]
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf
