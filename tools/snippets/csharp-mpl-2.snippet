<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>MPL 2.0 licence line for C#</Title>
            <Shortcut>mpl</Shortcut>
            <Author>Darin Morris</Author>
            <Description>Inserts the MPL 2.0 SPDX licence identifier at the top of a C# file.</Description>
        </Header>
        <Snippet>
            <Code Language="CSharp">
<![CDATA[// SPDX-License-Identifier: MPL-2.0

]]>
            </Code>
        </Snippet>
    </CodeSnippet>
</CodeSnippets>
