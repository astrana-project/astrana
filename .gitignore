# Node
node_modules/
application/frontend/dist/
application/frontend/storybook-static/
application/frontend/packages/*/dist/
npm-debug.log*
.vite/

# .NET
bin/
obj/
TestResults/
*.user
*.rsuser
*.suo

# Runtime state, which contains an instance's credentials, along with logs and local development settings. They are
# matched by name in any folder, so that moving a project does not expose them.
**/App_Data/
**/logs/
**/appsettings.Development.json

# Env
.env
.env.local

# Editors and operating systems
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
.working-state/

# Logs
*.log
